{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "1.2.0",
  "description": "__MSG_appDescription__",
  "homepage_url": "https://github.com/RicardoHipp/3D-Model-Auto-Downloader",
  "permissions": [
    "alarms",
    "downloads",
    "offscreen",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "https://*.bambulab.com/*",
    "https://*.bblmw.com/*",
    "https://printables.com/*",
    "https://*.printables.com/*",
    "https://*.prusa3d.com/*",
    "https://www.thingiverse.com/*",
    "https://*.thingiverse.com/*",
    "https://cdn.thingiverse.com/*",
    "https://cults3d.com/*",
    "https://*.cults3d.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.thingiverse.com/*",
        "https://*.thingiverse.com/*"
      ],
      "js": [
        "content_main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.thingiverse.com/*",
        "https://*.thingiverse.com/*"
      ],
      "js": [
        "content_isolated.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://printables.com/*",
        "https://*.printables.com/*",
        "https://makerworld.com/*",
        "https://*.makerworld.com/*"
      ],
      "js": [
        "content_dl_main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://printables.com/*",
        "https://*.printables.com/*",
        "https://makerworld.com/*",
        "https://*.makerworld.com/*"
      ],
      "js": [
        "content_dl_isolated.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.thingiverse.com/*",
        "https://*.thingiverse.com/*",
        "https://printables.com/*",
        "https://*.printables.com/*",
        "https://makerworld.com/*",
        "https://*.makerworld.com/*",
        "https://cults3d.com/*",
        "https://*.cults3d.com/*"
      ],
      "js": [
        "progress_banner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon_startup.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
